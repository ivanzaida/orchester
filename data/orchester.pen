                {
                  "type": "frame",
                  "id": "ukE2J",
                  "name": "Combination rules",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "gxfJV",
                      "name": "Combination rule",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Focus lives only in the box shadow. Hover, pressed and selected change fill, border and text as today and never set a shadow, so none of them can remove the ring.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "GF9bf",
                      "name": "Combination rule",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Focused + hover: the hover look plus the ring. Focused + pressed: the pressed look plus the ring (a click focuses the control).",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "eRfN8",
                      "name": "Combination rule",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Focused + selected: a selection drawn as a fill or underline ($hover fill, tab underline) stays and the ring is added, outside it behind the dark gap or inside for inset controls. Selection drawn as a stroke (1.5 inside $text: step card, option card) hides the focus ring: only the stroke shows.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "akrOD",
                      "name": "Combination rule",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Only form and dialog controls take focus. Everything outside forms (navigation, tabs, lists, canvas cards, toolbars, page actions, status bar, popover rows) is pointer-only: no Tab stop, no ring, and a click on it leaves focus where it is. Mouse and keyboard focus look the same. A click on empty space clears focus. Disabled controls are not focusable. Only one control is focused at a time.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "X4vyI",
                      "name": "Combination rule",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Outer ring needs 4 px of unclipped room around the control. Where a clipping container or a neighbour sits closer (stacked rows, toggles in a tight row), use the inset ring instead of padding the container.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "HgN9h",
                      "name": "Combination rule",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Fields and selects keep o8Oug: 1.5 inside $text stroke plus the caret. No ring.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
