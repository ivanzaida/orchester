                    {
                      "type": "text",
                      "id": "y2umZA",
                      "name": "State note",
                      "fill": "$subtle",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Tabs shrink together from 224 to 120; the active tab keeps at least 160 so its label and close button stay usable. Below 140 an inactive tab drops its close button (middle-click still closes it). When 120-wide tabs no longer fit, the strip scrolls horizontally (wheel or trackpad over the strip) with a 24px fade on the clipped edge, keeps the active tab in view, and a tab list button with the tab count appears after it. The list (select-menu style: 320 wide, 8 rows, then it scrolls) names every tab with its full location; the active one has the check; a click switches, middle-click closes. The + and at least 48px of drag area always stay visible.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
