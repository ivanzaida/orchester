            {
              "type": "text",
              "id": "Syy5Q",
              "x": 1568,
              "y": 630,
              "name": "Interaction notes",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": 1220,
              "content": "New task → brief, instructions and limits → plan approval → implementation → evidence → human review.\n\nSelecting a pipeline step reveals its agent, prompt, retry policy and budget. Changes save as a new version; active runs keep their original version.\n\nFailed checks return to implementation. Runner loss pauses work and preserves checkpoints. Retry never silently starts a second run.\n\nDesktop reference: 1440 × 960. At narrower widths, collapse navigation and open secondary panels on demand.",
              "lineHeight": 1.8,
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        }
      ]
