# The web front of Orchester Cloud (docs/architecture/server.md, "The cloud's web front"). Build from web/, the npm
# workspace, so the UI kit and the one lockfile come along:
#   docker build -f web/Dockerfile.cloud -t orchester-cloud-web web
# Configuration comes only from the environment at run time: ORCHESTER_CLOUD_PUBLIC_URL, ORCHESTER_CLOUD_API_URL
# and ORCHESTER_CLOUD_WEB_SECRET (32 random bytes in base64).
FROM node:24-alpine AS build
WORKDIR /web
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json tsconfig.base.json ./
COPY ui/package.json ui/
COPY cloud/package.json cloud/
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY ui ui
COPY cloud cloud
RUN npm run build --workspace cloud

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
# Next's standalone output keeps the workspace layout: the server is cloud/server.js.
COPY --from=build /web/cloud/.next/standalone ./
COPY --from=build /web/cloud/.next/static ./cloud/.next/static
USER node
EXPOSE 3000
CMD ["node", "cloud/server.js"]
