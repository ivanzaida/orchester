# Orchester Cloud with its web front (compose.web.yaml); replaces Caddyfile. No access log: the paths of the web
# front's pages (/confirm/{token}, /reset/{token}) carry one-time tokens.
{$ORCHESTER_CLOUD_PUBLIC_URL} {
    handle /api/* {
        reverse_proxy cloud:8090
    }
    handle {
        reverse_proxy web:3000
    }
    header Strict-Transport-Security "max-age=31536000"
}
