# The settings of an Orchester team server (deploy/server/README.md). Copy this file to `.env` beside the compose
# file, fill it in, and keep it readable only by you: `chmod 600 .env`. Never commit it.

# --- Every variant ---------------------------------------------------------------------------------------------------

# The image version: a release such as 0.1.3 (recommended; change it to upgrade), or `latest`.
ORCHESTER_VERSION=latest

# Required. Signs the admin's CSRF tokens and seals its cookies. Generate it once:
#   openssl rand -base64 32
# Changing it signs every browser out of the admin.
ORCHESTER_ADMIN_SECRET=

# The server's name until an admin renames it in the admin's Settings.
ORCHESTER_SERVER_NAME=Orchester

# Orchester Cloud's public address: signing in and linking through the browser, and invites by email. Leave it empty
# (`ORCHESTER_ADMIN_CLOUD_URL=`) on an air-gapped network or to use codes only.
ORCHESTER_ADMIN_CLOUD_URL=https://orchester-cloud.lurq.dev

# --- compose.yaml (Caddy) and compose.traefik.yaml -------------------------------------------------------------------

# Required there. The server's public DNS name, without https://, for example orchester.example.com (an A/AAAA
# record pointing to this host).
ORCHESTER_HOST=

# The proxy's certificate, for the key proofs apps check before entering a code: `auto` (or empty) reads it and its
# renewals at https://ORCHESTER_HOST; or its SHA-256 (64 hex characters), to set again after each renewal.
ORCHESTER_SERVER_PROXY_CERTIFICATE=auto

# The first three numbers of the stack's private /24 network (default 172.29.0, so 172.29.0.0/24). Change it only if
# `docker compose up` fails because another network on the host already uses it ("Pool overlaps").
ORCHESTER_SUBNET_PREFIX=172.29.0

# --- compose.private.yaml (own certificate, port 8740) ---------------------------------------------------------------

# Names and addresses people reach this host by, comma-separated, for the server's generated certificate, for
# example `orchester.internal,10.0.4.20`. Read only on the first start, when the certificate is made.
ORCHESTER_SERVER_TLS_NAMES=

# --- compose.traefik.yaml --------------------------------------------------------------------------------------------

# Required there. Traefik's address on its network, without a /prefix, for example 172.18.0.2. Find it with:
#   docker network inspect traefik --format '{{range .Containers}}{{.Name}} {{.IPv4Address}}{{println}}{{end}}'
# The server believes forwarded client addresses only from it.
TRAEFIK_ADDRESS=

# Traefik's external network, its HTTPS and HTTP entry points, and its certificate resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=letsencrypt
