# The team server's admin app on a Linux host without Docker: the Next.js standalone build of web/server
# (docs/server-hosting.md, "Without Docker"), copied to /opt/orchester-admin, run by the Node 24 in /usr/bin/node.
# It listens on loopback only; the team server forwards every path outside /api to it (admin_url) and the admin
# calls the server's private API listener (admin_api_listen). Put the secret in /etc/orchester/admin.env:
#   ORCHESTER_ADMIN_SECRET=<openssl rand -base64 32>
#   ORCHESTER_ADMIN_CLOUD_URL=https://orchester.cloud   (leave it out on an air-gapped network)
# then: systemctl enable --now orchester-admin
[Unit]
Description=Orchester team server admin
After=network-online.target orchester-server.service
Wants=network-online.target

[Service]
User=orchester
Group=orchester
WorkingDirectory=/opt/orchester-admin
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=127.0.0.1 PORT=3100
Environment=ORCHESTER_ADMIN_SERVER_URL=http://127.0.0.1:8741
EnvironmentFile=/etc/orchester/admin.env
ExecStart=/usr/bin/node server/server.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
